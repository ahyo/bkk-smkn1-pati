# ── Aplikasi ────────────────────────────────────────────────────────────────
APP_NAME="BKK SMK Negeri 1 Pati"
APP_ENV=development           # development | staging | production
DEBUG=true
BASE_URL=http://localhost:8000
SECRET_KEY=ganti-dengan-string-acak-panjang-min-32-karakter

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://bkk:bkk@localhost:5432/bkk_smkn1pati

# ── Upload ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=app/static/uploads
MAX_UPLOAD_MB=5

# ── Akun admin awal (dipakai oleh `python -m app.seed`) ─────────────────────
ADMIN_EMAIL=admin@bkksmkn1pati.sch.id
ADMIN_PASSWORD=Admin#12345
ADMIN_NAME="Administrator BKK"

# ── Kebijakan ───────────────────────────────────────────────────────────────
REQUIRE_JOB_APPROVAL=true     # lowongan harus disetujui admin sebelum tayang
REQUIRE_COMPANY_VERIFICATION=true
